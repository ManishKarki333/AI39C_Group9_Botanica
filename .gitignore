.env
# Python bytecode (Stops the pycache conflicts you just had)
__pycache__/
*.pyc
*.pyo
*.pyd

# Python virtual environment (Stops git from tracking thousands of library files)
venv/
.venv/
env/
ENV/

# Local databases (If you are using SQLite for local testing)
*.sqlite3
instance/

# IDE and Editor files (Keeps your personal VS Code/PyCharm settings out of the repo)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Operating system files
.DS_Store
Thumbs.db