*.py[cod]
*$py.class

# Virtual Environment (Very important to ignore this!)
venv/
env/
ENV/
.venv/

# Environment variables / Secrets
.env
.flaskenv

# Database files
*.db
*.sqlite3
instance/

# IDE settings
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# User / Merchant uploaded assets and images
app/static/uploads/**
!app/static/uploads/
!app/static/uploads/*/
!app/static/uploads/**/.gitkeep
